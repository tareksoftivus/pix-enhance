APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=admin_panel
DB_USERNAME=root
DB_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# Notification Channels
# ──────────────────────
# VAPID keys for Web Push — generate with: php artisan webpush:vapid
# (XAMPP users: set OPENSSL_CONF=D:\xampp\apache\conf\openssl.cnf first)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
